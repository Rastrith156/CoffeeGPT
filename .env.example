APP_NAME="CoffeeGPT Intelligence Platform"
APP_VERSION="1.0.0"
API_PREFIX="/api/v1"
ENVIRONMENT="development"
APP_DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="change_me_to_a_secure_random_string"

POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="coffeegpt"
POSTGRES_USER="coffeegpt_user"
POSTGRES_PASSWORD="your_postgres_password"
DATABASE_URL="postgresql://coffeegpt_user:your_postgres_password@localhost:5432/coffeegpt"

QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="coffee_intelligence"
EMBEDDING_VECTOR_SIZE=384

REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
USE_CELERY_FOR_INGESTION=false

LMSTUDIO_BASE_URL="http://localhost:1234"
LMSTUDIO_API_TOKEN=""
LLM_MODEL="dolphin-2.9-llama3-8b-256k-smashed"
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=700
LLM_CONTEXT_LENGTH=8192
LLM_TIMEOUT_SECONDS=60
EMBEDDING_MODEL="all-MiniLM-L6-v2"

OPENWEATHER_API_KEY=""
NEWSAPI_KEY=""
ICO_API_KEY=""

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=5

# Live Streaming & Hot Cache Layer
STREAM_INTERVAL_SECONDS=30
MONITOR_INTERVAL_SECONDS=15
INTELLIGENCE_LOOP_INTERVAL_SECONDS=120
SPIKE_THRESHOLD_PCT=2.0
HIGH_VOLATILITY_THRESHOLD_PCT=2.5
REDIS_PRICE_TTL_SECONDS=60
REDIS_ALERT_TTL_SECONDS=300
